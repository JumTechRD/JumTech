# Database connection used by Prisma.
# Must point to PostgreSQL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jumtech?schema=public"

# Secret used to sign admin JWTs.
JWT_SECRET="replace-with-a-long-random-secret"

# Optional public base URL for deployment setups that need an explicit origin.
# The app currently derives request origin from headers when possible.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
