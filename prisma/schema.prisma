// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String
  role      UserRole   @default(CLIENT)
  permissions String[] @default([])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([email])
}

enum UserRole {
  ADMIN
  CLIENT
}

model Service {
  id          String        @id @default(cuid())
  title       String
  description String
  image       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  quoteRequests QuoteRequest[]

  @@index([createdAt])
}

model Client {
  id             String        @id @default(cuid())
  name           String
  email          String        @unique
  phone          String
  companyName    String?
  identification String?       @unique
  address        String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  invoices       Invoice[]
  adminQuotes    AdminQuote[]
  quoteRequests  QuoteRequest[]

  @@index([name])
  @@index([phone])
}

model QuoteRequest {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  message   String
  serviceId String
  clientId  String?
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([serviceId])
  @@index([email])
  @@index([clientId])
}

model Product {
  id                   String           @id @default(cuid())
  nombre               String
  descripcion          String
  precio               Float
  categoria            String
  imagen               String?
  stock                Int              @default(0)
  rating               Float            @default(4)
  especificaciones     String[]         @default([])
  activo               Boolean          @default(true)
  fechaCreacion        DateTime         @default(now())
  fechaActualizacion   DateTime         @updatedAt
  precioCompra         Float?
  margenGanancia       Float?
  proveedor            String?
  codigoBarras         String?
  sku                  String?
  peso                 Float?
  dimensiones          Json?
  garantia             Int?
  ubicacion            String?
  stockMinimo          Int?
  stockMaximo          Int?
  vendido              Int              @default(0)
  ultimaVenta          DateTime?
  invoiceItems         InvoiceItem[]
  adminQuoteItems      AdminQuoteItem[]

  @@index([categoria])
  @@index([activo])
  @@index([fechaCreacion])
}

model Invoice {
  id          String        @id @default(cuid())
  numero      String
  cliente     String
  email       String
  telefono    String
  direccion   String
  clientId    String?
  sourceQuoteId String?      @unique
  paymentMethod String      @default("transferencia")
  fecha       DateTime
  vencimiento DateTime
  subtotal    Float
  impuestos   Float
  total       Float
  estado      String        @default("pendiente")
  notas       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  items       InvoiceItem[]
  client      Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  sourceQuote AdminQuote?   @relation("QuoteInvoice", fields: [sourceQuoteId], references: [id], onDelete: SetNull)

  @@index([estado])
  @@index([fecha])
  @@index([email])
  @@index([clientId])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  nombre           String
  descripcion      String
  precio           Float
  total            Float?
  profitPercentage Float?   @default(0)
  categoria        String
  imagen           String?
  cantidad         Int
  position         Int      @default(0)

  @@index([invoiceId])
  @@index([productId])
}

model AdminQuote {
  id                String           @id @default(cuid())
  numeroFactura     String?
  cliente           String
  email             String
  telefono          String
  clientId          String?
  tipoServicio      String?
  urgencia          String?
  descripcionProyecto String?
  ubicacionProyecto String?
  fecha             DateTime
  subtotal          Float
  impuestos         Float
  total             Float
  estado            String           @default("pendiente")
  notas             String?
  monedaPrincipal   String?
  itbisActivo       Boolean          @default(true)
  porcentajeItbis   Float?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  items             AdminQuoteItem[]
  client            Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  generatedInvoice  Invoice?         @relation("QuoteInvoice")

  @@index([estado])
  @@index([fecha])
  @@index([email])
  @@index([clientId])
}

model AdminQuoteItem {
  id              String      @id @default(cuid())
  adminQuoteId    String
  adminQuote      AdminQuote  @relation(fields: [adminQuoteId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  nombre          String
  descripcion     String
  precio          Float
  categoria       String
  cantidad        Int
  esManual        Boolean     @default(false)
  moneda          String?
  porcentajeExtra Float?
  position        Int         @default(0)

  @@index([adminQuoteId])
  @@index([productId])
}
